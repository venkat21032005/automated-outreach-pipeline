# API credentials
OCEAN_API_KEY=your_ocean_api_key
PROSPEO_API_KEY=your_prospeo_api_key
EAZYREACH_AUTH_TOKEN=your_eazyreach_auth_token
EAZYREACH_CLIENT_ID=your_eazyreach_client_id
EAZYREACH_CLIENT_SECRET=your_eazyreach_client_secret
BREVO_API_KEY=your_brevo_api_key

# Vendor endpoints
OCEAN_BASE_URL=https://api.ocean.io
OCEAN_LOOKALIKE_PATH=/v3/search/companies
PROSPEO_BASE_URL=https://api.prospeo.io
PROSPEO_SEARCH_PATH=/search-person

# Eazyreach accepts a LinkedIn URL as input but still requires authentication.
EAZYREACH_BASE_URL=https://api.superflow.run
EAZYREACH_AUTH_PATH=/b2b/createAuthToken/
EAZYREACH_ENRICH_PATH=/b2b/linkedin-emails

# Brevo sender must be verified in Brevo.
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=outreach@yourdomain.com
BREVO_SENDER_NAME=Outreach Team

# Runtime controls
REQUEST_TIMEOUT_MS=20000
PIPELINE_CONCURRENCY=1
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
OCEAN_PAGE_SIZE=50
OCEAN_MAX_PAGES=5
PROSPEO_PAGE_SIZE=25
PROSPEO_MAX_PAGES=5
LOG_LEVEL=info
