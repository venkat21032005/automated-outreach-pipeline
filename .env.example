# API credentials
OCEAN_API_KEY=your_ocean_api_key
PROSPEO_API_KEY=your_prospeo_api_key
BREVO_API_KEY=your_brevo_api_key
# Vendor endpoints
OCEAN_BASE_URL=https://api.ocean.io
OCEAN_LOOKALIKE_PATH=/v3/search/companies
PROSPEO_BASE_URL=https://api.prospeo.io
PROSPEO_SEARCH_PATH=/search-person

# Brevo sender must be verified in Brevo.
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=outreach@yourdomain.com
BREVO_SENDER_NAME=Outreach Team

# Runtime controls
REQUEST_TIMEOUT_MS=20000
PIPELINE_CONCURRENCY=1
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_MS=1000
OCEAN_PAGE_SIZE=50
OCEAN_MAX_PAGES=5
PROSPEO_PAGE_SIZE=25
PROSPEO_MAX_PAGES=5
LOG_LEVEL=info
